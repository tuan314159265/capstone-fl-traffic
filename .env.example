# Copy file này thành .env và điền giá trị thật — không commit .env
# FL / Experiment
FL_SERVER_ADDRESS=127.0.0.1:8080
WANDB_API_KEY=
WANDB_PROJECT=capstone-fl-traffic
DATA_ROOT=./data
RESULTS_ROOT=./results

# Traffic data providers (keep real keys in .env, never commit them)
API_TOMTOM=
API_TOMTOM_TRAFFIC=
TOMTOM_MONTHLY_REQUEST_BUDGET=18000
TOMTOM_TRAFFIC_MONTHLY_REQUEST_BUDGET=18000
GOOGLE_MAPS_API_KEY=
WAZE_DATA_FEED_URL=

# Local PostgreSQL/PostGIS prototype (docker-compose)
POSTGRES_DB=capstone_traffic
POSTGRES_USER=capstone
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql://capstone:change_me_locally@localhost:54329/capstone_traffic
